# Copy to .env and use your local PostgreSQL credentials.
# Local default; hosting services can supply PORT through their environment.
PORT=3001

PGHOST=localhost
PGPORT=5432
PGDATABASE=sift
PGUSER=sift_app
PGPASSWORD=replace_with_your_local_password

# Optional: minutes to wait after each import finishes (default 15).
NEWS_IMPORT_INTERVAL_MINUTES=15

# npm start enables production mode and serves client/dist.
# Build first with npm run build from this server directory.
# On a host, configure PG* settings directly; a .env file is optional.
