# Copy to .env and use your local PostgreSQL credentials.
# Local default; hosting services can supply PORT through their environment.
PORT=3001

# Hosting: set DATABASE_URL to the PostgreSQL URL from Neon's Connect dialog.
# It takes priority over the PG* settings below and uses verified TLS.
# Keep the real URL in host environment settings or secrets, never in Git.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# Local development (used when DATABASE_URL is not set):
PGHOST=localhost
PGPORT=5432
PGDATABASE=sift
PGUSER=sift_app
PGPASSWORD=replace_with_your_local_password

# Optional: minutes to wait after each import finishes (default 15).
NEWS_IMPORT_INTERVAL_MINUTES=15

# npm start enables production mode and serves client/dist.
# Build first with npm run build from this server directory.
# On a host, configure DATABASE_URL directly; a .env file is optional.
